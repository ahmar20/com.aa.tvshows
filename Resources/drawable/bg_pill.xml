<?xml version="1.0" encoding="utf-8"?>
<!-- outlined pill (Genres shortcut on the phone hero, genre chips) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55ffffff">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorOnSurface" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorSurfaceHigh" />
                    <stroke android:width="2dp" android:color="@color/colorFocus" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#99ffffff" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<!-- white focus ring (inset so the outline clip does not eat half the stroke) + touch feedback -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:inset="1.5dp">
            <shape android:shape="rectangle">
                <stroke android:width="3dp" android:color="@color/colorFocus" />
                <corners android:radius="@dimen/card_corner" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33ffffff" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorTransparent" />
        </shape>
    </item>
</selector>

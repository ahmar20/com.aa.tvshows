<?xml version="1.0" encoding="utf-8"?>
<!-- real ripple on tap (masked to the card's rounded rect) + a focus ring when a remote moves to it -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55ffffff">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/card_corner" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <inset android:inset="1.5dp">
                    <shape android:shape="rectangle">
                        <stroke android:width="3dp" android:color="@color/colorFocus" />
                        <corners android:radius="@dimen/card_corner" />
                    </shape>
                </inset>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorTransparent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:padding="32dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:padding="@dimen/margin_8dp"
        android:tint="@color/colorOnSurfaceMuted"
        android:id="@+id/empty_view_tagline_image" />
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:id="@+id/empty_view_header"
        android:layout_marginTop="@dimen/margin_8dp"
        style="@style/Text.Title" />
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:id="@+id/empty_view_content"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_8dp"
        style="@style/Text.Muted" />
    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/empty_view_retry_btn"
        android:layout_marginTop="@dimen/margin_8dp"
        android:minHeight="44dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/try_again_action"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="@color/btn_primary_content"
        android:background="@drawable/bg_btn_primary"
        android:focusable="true" />
</LinearLayout>

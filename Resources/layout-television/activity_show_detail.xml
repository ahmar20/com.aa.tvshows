<?xml version="1.0" encoding="utf-8"?>
<!-- TV show page: backdrop behind a left info column and a right-hand episode list -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWindow">

    <ImageView
        android:id="@+id/detail_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/detail_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/detail_title"
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:ellipsize="end" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/detail_rating"
                    style="@style/Text.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_star"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/colorStar"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/detail_meta"
                    style="@style/Text.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
            <TextView
                android:id="@+id/detail_overview"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="6"
                android:ellipsize="end" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/detail_btn_list"
                    style="@style/Widget.App.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_add"
                    android:text="@string/action_add_list" />
                <TextView
                    android:id="@+id/detail_btn_season"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/detail_episodes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:paddingBottom="24dp" />
        </FrameLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/detail_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/colorPrimary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detail_no_episodes"
        style="@style/Text.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/detail_no_episodes"
        android:visibility="gone" />
</FrameLayout>

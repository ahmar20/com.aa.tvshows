<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>com.aa.tvshows</RootNamespace>
    <AssemblyName>com.aa.tvshows</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>8.0</LangVersion>

    <!-- Carried over from the legacy AndroidManifest.xml package/version attributes -->
    <ApplicationId>com.ahm.tv.show.media</ApplicationId>
    <ApplicationVersion>20201109</ApplicationVersion>
    <ApplicationDisplayVersion>2.4.2</ApplicationDisplayVersion>

    <!--
      .NET 6+ for Android requires API 21 as the floor. The legacy manifest had
      minSdkVersion 19, bumped to 21 here since 19 is no longer supported.
      TargetSdkVersion matches the previous targetSdkVersion of 30; raise this
      separately if you also want to target a newer Android API level.
    -->
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <TargetPlatformVersion>30</TargetPlatformVersion>

    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidHttpClientHandlerType>Xamarin.Android.Net.AndroidMessageHandler</AndroidHttpClientHandlerType>

    <!--
      Properties/AssemblyInfo.cs still exists (trimmed to just the Android TV
      UsesFeature attributes), so let MSBuild generate AssemblyVersion/Title/etc.
      from the properties above instead of fighting over duplicate attributes.
    -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <AndroidLinkMode>None</AndroidLinkMode>
    <EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>
    <AndroidEnableMultiDex>false</AndroidEnableMultiDex>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableMultiDex>false</AndroidEnableMultiDex>
    <AndroidKeyStore>false</AndroidKeyStore>
    <AndroidSigningKeyStore>C:\Users\pakah\AppData\Local\Xamarin\Mono for Android\Keystore\ahmar16\ahmar16.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>.&lt;IamAhmar&gt;.</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>ahmar</AndroidSigningKeyAlias>
  </PropertyGroup>

  <!--
    SDK-style projects auto-glob Compile/AndroidResource/Assets/None items from
    the project directory, so every explicit <Compile Include>/<AndroidResource
    Include>/<None Include> item that used to be here has been removed. Only
    exclusions and package references are listed below.
  -->
  <ItemGroup>
    <!-- Auto-generated by the build; the legacy explicit copy would collide with it -->
    <Compile Remove="Resources\Resource.designer.cs" />
    <None Remove="Resources\Resource.designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.32" />
    <PackageReference Include="Jint" Version="3.0.0-beta-2031" />
    <PackageReference Include="Microsoft.AppCenter.Analytics" Version="5.0.7" />
    <PackageReference Include="Microsoft.AppCenter.Crashes" Version="5.0.7" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.10.0-1.final" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="Square.Picasso" Version="2.71828.0" />
    <PackageReference Include="Xam.Plugins.Android.ExoPlayer" Version="2.19.1" />
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.9.0.4" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.13.1.3" />
    <PackageReference Include="Xamarin.AndroidX.ExifInterface" Version="1.3.7.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.3" />
    <PackageReference Include="Xamarin.AndroidX.Media" Version="1.7.0.5" />
    <PackageReference Include="Xamarin.AndroidX.MultiDex" Version="2.0.1.34" />
    <PackageReference Include="Xamarin.AndroidX.Preference" Version="1.2.1.17" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.3.2.6" />
    <PackageReference Include="Xamarin.AndroidX.SwipeRefreshLayout" Version="1.1.0.22" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.11.0.1" />
  </ItemGroup>

</Project>

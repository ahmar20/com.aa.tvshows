<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>com.aa.tvshows</RootNamespace>
    <AssemblyName>com.aa.tvshows</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <ApplicationId>com.ahm.tv.show.media</ApplicationId>
    <ApplicationVersion>20201109</ApplicationVersion>
    <ApplicationDisplayVersion>2.4.2</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>

    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidHttpClientHandlerType>Xamarin.Android.Net.AndroidMessageHandler</AndroidHttpClientHandlerType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <AndroidLinkMode>None</AndroidLinkMode>
    <EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>
    <AndroidEnableMultiDex>false</AndroidEnableMultiDex>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableMultiDex>false</AndroidEnableMultiDex>
    <AndroidKeyStore>false</AndroidKeyStore>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Resources\Resource.designer.cs" />
    <None Remove="Resources\Resource.designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- exclude the project's own file that's being patched -->
    <Compile Remove="Helper\EpisodeRowsAdapter.cs" />

    <Compile Include="..\Me*-*es\H*\*.cs"
            Link="Helper\%(RecursiveDir)%(Filename)%(Extension)" />

    <Compile Include="..\Me*-*es\*.cs"
            Link="%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- .xml files are not compiled -->
    <AndroidResource Include="..\Me*-*es\R*s\l*t\*.xml"
          Link="Resources\layout\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Jint" Version="4.18.0" />
    <PackageReference Include="Microsoft.AppCenter.Analytics" Version="5.0.7" />
    <PackageReference Include="Microsoft.AppCenter.Crashes" Version="5.0.7" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Square.Picasso" Version="2.8.0.23" />
    <PackageReference Include="Xam.Plugins.Android.ExoPlayer" Version="2.19.1" />
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.13.0.1" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.ExifInterface" Version="1.4.2.3" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.9.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.1" />
    <PackageReference Include="Xamarin.AndroidX.Media" Version="1.8.0.1" />
    <PackageReference Include="Xamarin.AndroidX.MultiDex" Version="2.0.1.37" />
    <PackageReference Include="Xamarin.AndroidX.Preference" Version="1.2.1.18" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.6" />
    <PackageReference Include="Xamarin.AndroidX.SwipeRefreshLayout" Version="1.2.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common.Jvm" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Jvm" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.12.0" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.19.1" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.1" />

  </ItemGroup>

</Project>
